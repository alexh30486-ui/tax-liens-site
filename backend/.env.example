# =============================================================================
# Tax Lien Finder — environment (NEVER commit .env)
# Copy to backend/.env and fill values. All secrets live only here.
# =============================================================================

DATABASE_URL=postgresql://tlf:tlf@localhost:5432/taxlien
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

GEMINI_API_KEY=
SOCRATA_APP_TOKEN=

GEMINI_MODEL=gemini-2.0-flash
NYC_LIEN_ENDPOINT=https://data.cityofnewyork.us/resource/9rz4-mjek.json
JWT_EXPIRY_MINUTES=10080

MEILI_URL=http://127.0.0.1:7700
MEILI_INDEX=lien_opportunities

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
PUBLIC_ORIGIN=http://localhost:8080
ENABLE_HSTS=false
APP_ENV=development

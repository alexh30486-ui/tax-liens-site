[Unit]
Description=Meilisearch for Tax Lien Finder
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=tlf
Group=tlf
# Master key from EnvironmentFile — same key as MEILI_MASTER_KEY in backend/.env
EnvironmentFile=-/opt/tax-lien-finder/backend/.env
Environment=MEILI_ENV=production
Environment=MEILI_NO_ANALYTICS=true
Environment=MEILI_DB_PATH=/var/lib/meilisearch/data
ExecStart=/usr/local/bin/meilisearch --http-addr 127.0.0.1:7700 --env production
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meilisearch

[Install]
WantedBy=multi-user.target

# Postgres connection string (free tier: Neon, Supabase, or Fly Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini API key (free tier)
GEMINI_API_KEY=your_key_here

# Optional: raises Socrata's unauthenticated rate limit
SOCRATA_APP_TOKEN=

# Optional: override if the NYC dataset resource id changes
NYC_LIEN_ENDPOINT=https://data.cityofnewyork.us/resource/9rz4-mjek.json
